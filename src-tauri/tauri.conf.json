{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal DualSense Haptics",
  "version": "0.4.0",
  "identifier": "com.ajapaukese.dualsense-haptics",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Universal DualSense Haptics",
        "width": 820,
        "height": 540,
        "resizable": false,
        "center": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null
    }
  }
}
